<style>

:root{
--bg:#050b14;
--card:#101826;
--blue:#00bfff;
--blue2:#0077ff;
--text:#ffffff;
--muted:#9aa4b2;
--border:#1f2b3d;
--green:#25D366;
--gold:#ffd700;
}

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Segoe UI,sans-serif;
}

body{
background:linear-gradient(to bottom,#030712,#071120);
color:var(--text);
display:flex;
overflow-x:hidden;
}

/* TOP CORNER */

.top-corner{
position:fixed;
top:10px;
right:10px;
font-size:0.8rem;
font-weight:bold;
color:#00bfff;
text-align:center;
z-index:9999;
line-height:1.2;
text-shadow:
0 0 5px #00bfff,
0 0 10px #00bfff,
0 0 20px #0077ff;
animation:glow 2s infinite alternate;
}

/* SIDEBAR */

.sidebar{
width:280px;
height:100vh;
background:rgba(10,15,25,0.95);
backdrop-filter:blur(10px);
border-right:1px solid var(--border);
position:fixed;
padding:20px;
overflow-y:auto;
z-index:1000;
transition:0.3s;
}

.brand{
text-align:center;
font-size:1.5rem;
font-weight:900;
margin-bottom:25px;
color:white;
text-shadow:
0 0 10px #00bfff,
0 0 20px #0077ff;
animation:glow 2s infinite alternate;
}

.menu-title{
font-size:0.8rem;
color:var(--muted);
margin:15px 0 10px;
text-transform:uppercase;
letter-spacing:1px;
}

.menu-btn{
display:block;
width:100%;
padding:14px;
margin-bottom:12px;
background:#111827;
border:1px solid var(--border);
color:white;
border-radius:12px;
transition:0.3s;
font-weight:700;
cursor:pointer;
}

.menu-btn:hover{
background:rgba(0,191,255,0.15);
transform:translateX(6px);
box-shadow:0 0 20px rgba(0,191,255,0.4);
}

/* MAIN */

.main{
margin-left:280px;
padding:25px;
width:100%;
}

/* HEADER */

.header{
background:linear-gradient(135deg,#081120,#0d2038);
padding:35px;
border-radius:20px;
border:1px solid #16304f;
text-align:center;
margin-bottom:25px;
box-shadow:0 0 30px rgba(0,191,255,0.15);
}

.skull-logo{
font-size:4rem;
margin-bottom:10px;
animation:float 3s infinite ease-in-out;
filter:drop-shadow(0 0 20px #00bfff);
}

.main-title{
font-size:2.5rem;
font-weight:900;
color:white;
text-shadow:
0 0 10px #00bfff,
0 0 20px #0077ff,
0 0 40px #00bfff;
animation:glow 2s infinite alternate;
}

.header p{
margin-top:10px;
color:#c0d9ff;
font-size:0.95rem;
}

/* PAGE SYSTEM */

.page{
display:none;
animation:fade 0.4s ease;
}

.active-page{
display:block;
}

@keyframes fade{
from{
opacity:0;
transform:translateY(10px);
}
to{
opacity:1;
transform:translateY(0);
}
}

/* CARD */

.card{
background:rgba(16,24,38,0.95);
padding:22px;
border-radius:18px;
border:1px solid var(--border);
margin-bottom:20px;
box-shadow:0 0 20px rgba(0,0,0,0.2);
}

.card h2{
margin-bottom:18px;
font-size:1.4rem;
}

/* CONFIG BOX */

.config-box{
background:#0b1320;
padding:18px;
border-radius:14px;
border:1px solid #1d2b3f;
margin-bottom:18px;
transition:0.3s;
}

.config-box:hover{
transform:translateY(-3px);
box-shadow:0 0 20px rgba(0,191,255,0.2);
}

.config-box h3{
margin-bottom:10px;
}

.config-box p{
color:var(--muted);
margin-bottom:14px;
}

/* BUTTON */

.download-btn{
display:inline-block;
padding:12px 18px;
background:linear-gradient(to right,#00bfff,#0077ff);
border-radius:10px;
text-decoration:none;
color:white;
font-weight:800;
transition:0.3s;
}

.download-btn:hover{
transform:scale(1.05);
box-shadow:0 0 20px rgba(0,191,255,0.5);
}

/* CONFIG ACTIONS */

.config-actions{
display:flex;
gap:10px;
margin-top:15px;
margin-bottom:15px;
flex-wrap:wrap;
}

.action-btn{
padding:10px 14px;
border:none;
border-radius:10px;
background:#111827;
color:white;
font-weight:700;
cursor:pointer;
transition:0.3s;
border:1px solid #1f2b3d;
}

.action-btn:hover{
background:rgba(0,191,255,0.15);
box-shadow:0 0 15px rgba(0,191,255,0.4);
}

/* COMMENTS */

.comment-section{
margin-top:12px;
}

.comment-input{
width:100%;
padding:12px;
border-radius:10px;
border:1px solid #1f2b3d;
background:#0b1320;
color:white;
outline:none;
margin-bottom:10px;
}

.comment-btn{
padding:10px 16px;
border:none;
border-radius:10px;
background:linear-gradient(to right,#00bfff,#0077ff);
color:white;
font-weight:800;
cursor:pointer;
}

.comments-list{
margin-top:15px;
}

.comment{
background:#0f1724;
padding:10px;
border-radius:10px;
margin-bottom:10px;
border:1px solid #1d2b3f;
color:#dbe7ff;
font-size:0.9rem;
}

/* SOCIALS */

.socials{
display:grid;
grid-template-columns:1fr 1fr;
gap:15px;
}

.social-card{
background:#0b1320;
padding:20px;
border-radius:14px;
border:1px solid #1d2b3f;
text-align:center;
}

.social-card a{
display:inline-block;
margin-top:12px;
padding:12px 18px;
border-radius:10px;
text-decoration:none;
color:white;
font-weight:800;
background:var(--green);
}

/* LISTS */

.rules li,
.safety li{
margin-bottom:15px;
line-height:1.6;
color:#d2d8e2;
}

/* OWNER */

.owner-box{
text-align:center;
padding:25px;
background:#0b1320;
border-radius:16px;
border:1px solid #1d2b3f;
}

.owner-box h2{
color:var(--gold);
margin-bottom:10px;
}

/* FOOTER */

.footer{
text-align:center;
margin-top:25px;
color:#7f8ea3;
font-size:0.9rem;
}

/* MOBILE */

.mobile-btn{
display:none;
position:fixed;
top:15px;
left:15px;
z-index:2000;
background:#111827;
border:1px solid var(--border);
color:white;
padding:12px 15px;
border-radius:10px;
cursor:pointer;
}

@media(max-width:768px){

.sidebar{
transform:translateX(-100%);
}

.sidebar.show{
transform:translateX(0);
}

.main{
margin-left:0;
padding-top:80px;
}

.mobile-btn{
display:block;
}

.socials{
grid-template-columns:1fr;
}

.main-title{
font-size:2rem;
}

.top-corner{
font-size:0.65rem;
}
}

/* ANIMATIONS */

@keyframes glow{
from{
text-shadow:
0 0 10px #00bfff,
0 0 20px #0077ff;
}
to{
text-shadow:
0 0 20px #00bfff,
0 0 40px #0077ff,
0 0 60px #00bfff;
}
}

@keyframes float{
0%{transform:translateY(0);}
50%{transform:translateY(-8px);}
100%{transform:translateY(0);}
}

</style>

</head>

