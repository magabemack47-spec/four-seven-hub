<script>

function toggleMenu() {
document.getElementById("sidebar").classList.toggle("show");
}

function showPage(pageId){

const pages=document.querySelectorAll(".page");

pages.forEach(page=>{
page.classList.remove("active-page");
});

document.getElementById(pageId)
.classList.add("active-page");

if(window.innerWidth < 768){
document.getElementById("sidebar")
.classList.remove("show");
}
}

function likeFile(button){

let count =
button.querySelector(".like-count");

count.innerText =
parseInt(count.innerText)+1;
}

function increaseDownload(link){

let box =
link.closest(".config-box");

let count =
box.querySelector(".download-count");

count.innerText =
parseInt(count.innerText)+1;
}

function addComment(button){

let section =
button.parentElement;

let input =
section.querySelector(".comment-input");

let commentsList =
section.querySelector(".comments-list");

if(input.value.trim() !== ""){

let comment =
document.createElement("div");

comment.className = "comment";

comment.innerText = input.value;

commentsList.prepend(comment);

input.value = "";
}
}

window.addEventListener("offline", () => {
console.log("Offline mode");
});

</script>

